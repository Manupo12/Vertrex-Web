# === Base de Datos ===
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# === Auth ===
AUTH_SECRET=your-secret-at-least-32-chars-long
MCP_SECRET=another-secret-for-mcp-api

# === Cifrado ===
ENCRYPTION_KEY=32-char-hex-key-for-aes-256

# === Google Drive (OAuth2) ===
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# === Email (Resend) ===
RESEND_API_KEY=re_xxxx
EMAIL_FROM=no-reply@vertrex.com
PORTAL_NOTIFICATIONS_ENABLED=false

# === Stripe ===
STRIPE_SECRET_KEY=sk_test_xxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx

# === Upstash Redis (Rate Limiting) ===
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# === Vercel (para enlaces de portal) ===
PUBLIC_APP_URL=https://os.vertrex.com
SHARE_TOKEN_DEFAULT_TTL_HOURS=168

# === Seed (admin inicial) ===
SEED_ADMIN_EMAIL=admin@vertrex.com
SEED_ADMIN_PASSWORD=your-secure-password

# === Opcionales ===
GITHUB_TOKEN=ghp_xxxx
GOOGLE_CALENDAR_PUBLIC_ICS=https://calendar.google.com/calendar/ical/xxxx/basic.ics
LOG_LEVEL=info

# === Telegram ===
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_GROUP_CHAT_ID=-1001234567890
TELEGRAM_NOTIFICATIONS_ENABLED=false

